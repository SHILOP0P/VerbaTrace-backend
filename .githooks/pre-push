#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000

while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_oid" != "$zero" ] || continue
  sh "$repo_root/scripts/check-repository-docs.sh" --tree "$local_oid"
  if [ "$remote_oid" != "$zero" ] && git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
    commits=$(git rev-list "$local_oid" "^$remote_oid")
  else
    commits=$(git rev-list "$local_oid" --not --remotes)
  fi
  for commit in $commits; do
    sh "$repo_root/scripts/check-repository-docs.sh" --tree "$commit"
  done
done
