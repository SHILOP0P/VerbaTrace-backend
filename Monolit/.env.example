HTTP_HOST=localhost
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
# Proxies whose X-Forwarded-For may be trusted. Empty means the connection address is used.
TRUSTED_PROXY_CIDRS=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=verbatrace
POSTGRES_TEST_DB=verbatrace_test
POSTGRES_USER=verbatrace_user
POSTGRES_PASSWORD=verbatrace
POSTGRES_SSL_MODE=disable

MIGRATION_DIRECTORY=./migrations
UPLOAD_PATH=./uploads
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

LOG_LEVEL=info
LOG_AS_JSON=false

WORKER_ENABLED=true
WORKER_POLL_INTERVAL=2s
WORKER_LIMIT=1
WORKER_RETRY_DELAY=1m
WORKER_STALE_AFTER=30m
WORKER_MAX_ATTEMPTS=5
CALL_RETENTION_INTERVAL=24h
CALL_RETENTION_BATCH=100
INSTRUCTION_RETENTION_INTERVAL=25h
INSTRUCTION_RETENTION_BATCH=50

TRANSCRIBER_PROVIDER=assemblyai
# Used for AssemblyAI transcription, diarization and role identification.
ASSEMBLYAI_API_KEY=

# openrouter — production analysis. mock — one fixed schema v2 result.
# mock_staged — the real staged pipeline with deterministic answers and no
# network; use it to verify analysis changes locally without paid calls.
ANALYZER_PROVIDER=openrouter
ANALYZER_API_KEY=
# Рекомендуемая недорогая OpenRouter-модель для анализа русских звонков.
ANALYZER_MODEL=openai/gpt-5-mini

# Optional. When unset, content search uses the PostgreSQL lexical fallback and
# the assistant remains disabled rather than pretending semantic search ran.
EMBEDDING_PROVIDER=openrouter
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
ASSISTANT_PROVIDER=openrouter
ASSISTANT_API_KEY=
ASSISTANT_MODEL=

# Mail and Telegram messages. Only "mock" exists for now: it logs the message
# and marks it sent. The bell in the app does not depend on it.
NOTIFY_SENDER=mock
# Where links in messages point.
PUBLIC_APP_URL=http://127.0.0.1:5173

PASSWORD_PEPPER=change-me
JWT_SECRET=change-me
JWT_ACCESS_TOKEN_TTL=1h

REFRESH_TOKEN_SECRET=change-me
REFRESH_TOKEN_TTL=720h
AUTH_SESSION_TRUST_AGE=24h
